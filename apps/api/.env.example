# Copy to apps/api/.env for local development. Never commit the real .env.
MLA_ENVIRONMENT=development
# Without PostgreSQL the API falls back to SQLite in apps/api/.data/ (development only).
# MLA_DATABASE_URL=postgresql+psycopg://mla:mla-dev-password@localhost:5432/mla
MLA_COOKIE_SECURE=false
MLA_PUBLIC_URL=http://localhost:3000
MLA_ALLOW_SIGNUP=true
# Serve the static frontend build from the API (production-like, single origin):
# MLA_WEB_DIST_DIR=../web/out

# --- Estúdio de IA (D-035). Off unless BOTH the key and MLA_IMAGE_AI_ENABLED=true are set. Paid calls. ---
# MLA_IMAGE_AI_PROVIDER=openai
# MLA_OPENAI_API_KEY=            # server only; never sent to the browser
# MLA_IMAGE_AI_ENABLED=false     # set true only after authorizing the use
# MLA_IMAGE_AI_BUDGET_USD=5      # installation-wide limit; new requests are refused once reached
# MLA_IMAGE_AI_RESERVE_USD=0.25  # held per request before the call
# MLA_OPENAI_IMAGE_MODEL=gpt-image-2
# MLA_OPENAI_IMAGE_QUALITY=medium

