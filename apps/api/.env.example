# Copy to apps/api/.env for local development. Never commit the real .env.
MLA_ENVIRONMENT=development
# Without PostgreSQL the API falls back to SQLite in apps/api/.data/ (development only).
# MLA_DATABASE_URL=postgresql+psycopg://mla:mla-dev-password@localhost:5432/mla
MLA_COOKIE_SECURE=false
MLA_PUBLIC_URL=http://localhost:3000
MLA_ALLOW_SIGNUP=true
# Serve the static frontend build from the API (production-like, single origin):
# MLA_WEB_DIST_DIR=../web/out
