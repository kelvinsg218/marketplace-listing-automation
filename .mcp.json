{
  "mcpServers": {
    "chrome-devtools": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--isolated",
        "--no-usage-statistics",
        "--categoryPerformance=false",
        "--categoryMemory=false",
        "--categoryEmulation=false"
      ]
    }
  }
}
